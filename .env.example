# Airtable
AIRTABLE_TOKEN=pat...
AIRTABLE_BASE_ID=appNUnSm9ZMCmASpG
AIRTABLE_RECIPES_TABLE=tbl3nxPX4QFiTnbxD     # "Eagle Recipes" table
AIRTABLE_DESIGNS_TABLE=tblLz44lYKbaU9Nge

# Storage
DATA_DIR=/Users/bre/eagle-bridge/data
