# Bridge
BRIDGE_PORT=3110
BRIDGE_TOKEN=change-me-long-random

# Eagle (localhost API on veggie)
EAGLE_API=http://localhost:41595
EAGLE_TOKEN=                       # from Eagle → Preferences → Developer (may be blank)

# Airtable
AIRTABLE_TOKEN=pat...
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_RECIPES_TABLE=tblXXXXXXXXXXXXXX     # "Eagle Recipes" table
AIRTABLE_DESIGNS_TABLE=tblXXXXXXXXXXXXXX

# Storage
DATA_DIR=/path/to/eagle-bridge/data
RECIPE_TTL_MS=3600000

# Real-ESRGAN (install via scripts/install-realesrgan.sh; models are a follow-up)
REALESRGAN_BIN=/path/to/eagle-bridge/bin/realesrgan-ncnn-vulkan-v0.2.0-macos/realesrgan-ncnn-vulkan

# Auto-tagging (local vision, e.g. Ollama running on another machine on your network)
OLLAMA_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llama3.2-vision:11b
AUTOTAG_ON_INGEST=true
AUTOTAG_CONCURRENCY=1
AUTOTAG_IMAGE_PX=640
AUTOTAG_TIMEOUT_MS=300000
AUTOTAG_MAX_ATTEMPTS=3
